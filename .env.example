# XRP-Viewer Configuration Example
# Скопируйте этот файл в .env и заполните своими значениями

# Сеть по умолчанию (mainnet, testnet, devnet)
DEFAULT_NETWORK=mainnet

# Приватные ключи для разных сетей
# ВАЖНО: Используйте РАЗНЫЕ ключи для mainnet и testnet!

# Mainnet - реальные деньги, максимальная безопасность
XRP_PRIVATE_KEY_MAINNET=

# Testnet - тестовая сеть, можно использовать тот же адрес что и в mainnet
# но рекомендуется создать отдельный для безопасности
XRP_PRIVATE_KEY_TESTNET=sEdVdTXCmVoQWJYbMHcSiUGmCbVZDz6

# Devnet - экспериментальная сеть
XRP_PRIVATE_KEY_DEVNET=

# Дополнительные настройки
VERBOSE=false
COLOR_OUTPUT=true

# Custom RPC endpoints (опционально)
# MAINNET_RPC_URL=https://xrplcluster.com/
# TESTNET_RPC_URL=https://s.altnet.rippletest.net:51234/
# DEVNET_RPC_URL=https://s.devnet.rippletest.net:51234/